NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/skillsetu
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=10m
JWT_COOKIE_NAME=skillsetu_token
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SkillSetu <noreply@skillsetu.local>
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
UPLOAD_MAX_MB=5

# Learning AI only; credentials remain server-side.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# openrouter, nvidia, gemini, openai or auto. If unset: nvidia when its key exists, otherwise auto.
AI_PROVIDER=nvidia
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS=4096
AI_QUOTA_COOLDOWN_MS=3600000
GEMINI_MODEL=gemini-flash-latest

# Explicit opt-in: AI_PROVIDER=openrouter. Only this exact free model is allowed.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Student Courses: official YouTube Data API v3, backend only.
YOUTUBE_API_KEY=

# Student Resources: Tavily free-tier basic search, backend only.
TAVILY_API_KEY=
