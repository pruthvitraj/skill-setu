NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# Mongo
MONGO_URI=mongodb://localhost:27017/skillsetu

# Redis (optional)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=10m
JWT_COOKIE_NAME=skillsetu_token

# Email (optional in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SkillSetu <noreply@skillsetu.local>

# AI (optional — rules-based fallbacks run without keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# Storage
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
UPLOAD_MAX_MB=5
